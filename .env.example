# Database
# For Railway PostgreSQL, use the connection string provided by Railway
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Authentication
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic AI (for contract analysis)
ANTHROPIC_API_KEY="your-anthropic-api-key"

# File Storage (AWS S3 or Cloudflare R2)
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="deal-pilot-documents"
S3_REGION="us-east-1"
S3_ENDPOINT=""  # Leave empty for AWS S3, set for R2 or other S3-compatible services

# Email (Resend or SendGrid)
RESEND_API_KEY="your-resend-api-key"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
